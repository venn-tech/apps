# API
DATABASE_URL=postgres://hackaton:hackaton@localhost:5433/hackaton
PORT=3334
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
# Armazenamento: Cloudflare R2 (API compativel com S3)
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (Cloudflare > R2 > Overview)
# Chaves: R2 > Manage API tokens > Create (permissao Object Read & Write no bucket)
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=nome-do-seu-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Dev local sem R2 (docker compose up -d minio): endpoint http://localhost:9000, bucket hackaton, minioadmin/minioadmin, FORCE_PATH_STYLE=true
# E-mail (opcional; sem a chave o link de recuperação é impresso no log)
RESEND_API_KEY=
MAIL_FROM="venn <nao-responda@venn-hackatons.online>"
# Seed
SEED_ADMIN_EMAIL=organizacao@example.com
SEED_ADMIN_PASSWORD=troque-esta-senha
