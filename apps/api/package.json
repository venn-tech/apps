    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@hackaton/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "resend": "^6.37.0",
